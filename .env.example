# Ruby — copy this file to ".env" on the computer where you run Ruby, then
# put a FRESH key in it. Never put a real key in this example file, never
# commit ".env" to GitHub, and never paste a key in chat.
#
# How to use it:
#   cp .env.example .env
#   # edit .env, replace the placeholder below with your fresh key
#   node server.js
#
# Get a fresh key (delete any key you shared in chat first):
#   Google AI Studio: https://aistudio.google.com/apikey
#   Groq: https://console.groq.com/keys
#
# Set only the provider you want to use. Ruby tries configured providers
# in order and falls back to her local brain if the LLM call fails.

# Google Gemini (free tier)
GEMINI_API_KEY=your-fresh-gemini-key-here
# GEMINI_MODEL=gemini-3.8-flash

# Groq (free tier)
# GROQ_API_KEY=your-fresh-groq-key-here
# GROQ_MODEL=openai/gpt-oss-120b

# OpenAI (paid)
# OPENAI_API_KEY=your-openai-key-here
# OPENAI_MODEL=gpt-4o-mini
